SEASONS = ["春", "夏", "秋", "冬"]
COUNTRIES = ["日本", "韓國", "法國", "中國", "台灣", "香港", "意大利", "美國", "泰國", "西班牙", "威爾士", "印度", "Fusion"]

# 國旗 emoji 對應
FLAG_EMOJI = {
    "日本": "🇯🇵",
    "韓國": "🇰🇷",
    "法國": "🇫🇷",
    "中國": "🇨🇳",
    "台灣": "🇹🇼",
    "香港": "🇭🇰",
    "意大利": "🇮🇹",
    "美國": "🇺🇸",
