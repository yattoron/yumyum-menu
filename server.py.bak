      for (var i = 0; i < items.length; i++) {{
        var title = items[i].querySelector('.title');
        var text = title ? title.textContent.toLowerCase() : '';
        items[i].style.display = (!kw || text.indexOf(kw) !== -1) ? '' : 'none';
