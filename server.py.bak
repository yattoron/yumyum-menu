class PortfolioHandler(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        print(f"[{self.log_date_time_string()}] {args[0]}")

    def send_html(self, content, status=200):
        data = content.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache, no-store, must-revalidate")
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, data, status=200):
        content = json.dumps(data, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(content)))
        self.end_headers()
        self.wfile.write(content)

    def send_redirect(self, location, set_cookie=None):
        self.send_response(302)
        self.send_header("Location", location)
        if set_cookie:
            self.send_header("Set-Cookie", set_cookie)
        self.end_headers()

    def send_file(self, path, content_type=None):
        if not os.path.exists(path):
            self.send_error(404)
            return
        with open(path, "rb") as f:
            data = f.read()
        if not content_type:
            ext = os.path.splitext(path)[1].lower()
            types = {".css": "text/css; charset=utf-8", ".png": "image/png", ".jpg": "image/jpeg",
                     ".jpeg": "image/jpeg", ".webp": "image/webp", ".gif": "image/gif"}
            content_type = types.get(ext, "application/octet-stream")
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        try:
            parsed = urlparse(self.path)
            path = unquote(parsed.path)

            if path == "/about":
                with open(os.path.join(TEMPLATES_DIR, "about.html"), "r", encoding="utf-8") as f:
                    self.send_html(f.read())
                return

            if path == "/memories":
                memories = load_memories()
                memories = sorted(memories, key=lambda x: x.get("created_at", ""))
                with open(os.path.join(TEMPLATES_DIR, "memories.html"), "r", encoding="utf-8") as f:
                    tpl = f.read()
                if memories:
                    photos = []
                    for i, m in enumerate(memories):
                        rot = (i % 5 - 2) * 2
                        photo = f'<div class="polaroid" style="--rot:{rot}deg;"><div class="clip"></div><img src="/uploads/{html.escape(m["filename"])}" alt=""></div>'
                        photos.append(photo)
                    photos_html = "\n".join(photos)
                else:
                    photos_html = '<div class="empty-msg">還沒有回憶，請稍後再來看看～</div>'
                self.send_html(tpl.replace("<!-- PHOTOS_PLACEHOLDER -->", photos_html))
                return

            if path == "/" or path == "/index.html":
                works = load_works()
                works = sorted(works, key=lambda x: x.get("likes", 0), reverse=True)
                self.send_html(render_index(works))
                return

            if path.startswith("/comments/"):
                work_id = path.split("/comments/")[-1].strip("/")
                works = load_works()
                work = next((w for w in works if w.get("id") == work_id), None)
                if work:
                    self.send_json({"comments": work.get("comments", [])})
                else:
                    self.send_json({"comments": []})
                return

            if path == "/admin" or path == "/admin/":
                if is_logged_in(self):
                    self.send_redirect("/admin/dashboard")
                else:
                    self.send_html(render_admin_login())
                return

            if path == "/admin/dashboard":
                if not is_logged_in(self):
                    self.send_redirect("/admin")
                    return
                works = load_works()
                works = sorted(works, key=lambda x: x.get("created_at", ""), reverse=True)
                self.send_html(render_admin(works))
                return

            if path.startswith("/admin/edit/"):
                if not is_logged_in(self):
                    self.send_redirect("/admin")
                    return
                work_id = path.split("/admin/edit/")[-1].strip("/")
                works = load_works()
                work = next((w for w in works if w.get("id") == work_id), None)
                if not work:
                    self.send_redirect("/admin/dashboard")
                    return
                self.send_html(render_edit(work))
                return

            if path == "/admin/logout":
                sid = get_session_id(self)
                if sid and sid in SESSIONS:
                    del SESSIONS[sid]
                self.send_redirect("/", set_cookie="sid=; Path=/; Max-Age=0")
                return

            if path.startswith("/static/"):
                rel = path[len("/static/"):]
                file_path = os.path.normpath(os.path.join(STATIC_DIR, rel))
                if not file_path.startswith(os.path.abspath(STATIC_DIR)):
                    self.send_error(403)
                    return
                self.send_file(file_path)
                return

            if path.startswith("/uploads/"):
                rel = path[len("/uploads/"):]
                file_path = os.path.normpath(os.path.join(UPLOAD_DIR, rel))
                if not file_path.startswith(os.path.abspath(UPLOAD_DIR)):
                    self.send_error(403)
                    return
                self.send_file(file_path)
                return

            self.send_error(404)
        except Exception as e:
            print(f"GET Error: {e}")
            import traceback
            traceback.print_exc()
            self.send_error(500)

    def do_POST(self):
        try:
            parsed = urlparse(self.path)
            path = unquote(parsed.path)

            if path.startswith("/like/"):
                work_id = path.split("/like/")[-1].strip("/")
                works = load_works()
                for w in works:
                    if w.get("id") == work_id:
                        w["likes"] = w.get("likes", 0) + 1
                        save_works(works)
                        self.send_json({"success": True, "likes": w["likes"]})
                        return
                self.send_json({"success": False}, 404)
                return

            if path.startswith("/comment/"):
                work_id = path.split("/comment/")[-1].strip("/")
                content_length = int(self.headers.get("Content-Length", 0))
                body = self.rfile.read(content_length).decode("utf-8", errors="ignore")
                params = parse_qs(body)
                name = params.get("name", ["匿名"])[0].strip() or "匿名"
                text = params.get("text", [""])[0].strip()
                if not text:
                    self.send_json({"success": False, "error": "請輸入內容"}, 400)
                    return
                works = load_works()
                for w in works:
                    if w.get("id") == work_id:
                        if "comments" not in w:
                            w["comments"] = []
                        w["comments"].append({
                            "id": str(uuid.uuid4())[:8],
                            "name": name,
                            "text": text,
                            "time": datetime.now().strftime("%Y-%m-%d %H:%M")
                        })
                        save_works(works)
                        self.send_json({"success": True, "comments": w["comments"]})
                        return
                self.send_json({"success": False}, 404)
                return

            if path == "/admin":
                content_length = int(self.headers.get("Content-Length", 0))
                body = self.rfile.read(content_length).decode("utf-8", errors="ignore")
                params = parse_qs(body)
                password = params.get("password", [""])[0]
                if password == ADMIN_PASSWORD:
                    sid = create_session()
                    self.send_redirect("/admin/dashboard", set_cookie=f"sid={sid}; Path=/; HttpOnly")
                else:
                    self.send_html(render_admin_login(error="密碼錯誤，請再試一次"))
                return
            if path == "/admin/upload-memory":
                if not is_logged_in(self):
                    self.send_redirect("/admin")
                    return
                content_type = self.headers.get("Content-Type", "")
                if "multipart/form-data" not in content_type:
                    self.send_redirect("/admin/dashboard")
                    return
                form = cgi.FieldStorage(fp=self.rfile, headers=self.headers, environ={"REQUEST_METHOD": "POST", "CONTENT_TYPE": content_type})
                if "image" not in form:
                    self.send_redirect("/admin/dashboard")
                    return
                file_item = form["image"]
                filename = getattr(file_item, "filename", None)
                if not filename:
                    self.send_redirect("/admin/dashboard")
                    return
                ext = os.path.splitext(filename)[1].lower()
                if ext not in ALLOWED_EXT:
                    self.send_redirect("/admin/dashboard")
                    return
                new_filename = f"mem_{uuid.uuid4().hex[:8]}{ext}"
                filepath = os.path.join(UPLOAD_DIR, new_filename)
                with open(filepath, "wb") as f:
                    f.write(file_item.file.read())
                memories = load_memories()
                memories.append({
                    "id": str(uuid.uuid4())[:8],
                    "filename": new_filename,
                    "created_at": datetime.now().strftime("%Y-%m-%d %H:%M")
                })
                save_memories(memories)
                print(f"上傳 Memories：{new_filename}")
                self.send_redirect("/admin/dashboard")
                return

            if path == "/admin/upload":
                if not is_logged_in(self):
                    self.send_redirect("/admin")
                    return
                content_type = self.headers.get("Content-Type", "")
                if "multipart/form-data" not in content_type:
                    self.send_redirect("/admin/dashboard")
                    return
                form = cgi.FieldStorage(fp=self.rfile, headers=self.headers, environ={"REQUEST_METHOD": "POST", "CONTENT_TYPE": content_type})
                title = (form.getvalue("title") or "").strip() if "title" in form else ""
                steps = (form.getvalue("steps") or "").strip() if "steps" in form else ""
                category = (form.getvalue("category") or "主食").strip() if "category" in form else "主食"
                country = (form.getvalue("country") or "沒有").strip() if "country" in form else "沒有"
                tags_raw = (form.getvalue("tags") or "").strip() if "tags" in form else ""
                tags = [t.strip() for t in tags_raw.split(",") if t.strip()]
                seasons = form.getlist("season") if "season" in form else []
                season = ",".join(seasons) if isinstance(seasons, list) else seasons
                description = (form.getvalue("description") or "").strip() if "description" in form else ""
                if "image" not in form:
                    self.send_redirect("/admin/dashboard")
                    return
                file_item = form["image"]
                filename = getattr(file_item, "filename", None)
                if not title or not filename:
                    self.send_redirect("/admin/dashboard")
                    return
                ext = os.path.splitext(filename)[1].lower()
                if ext not in ALLOWED_EXT:
                    self.send_redirect("/admin/dashboard")
                    return
                safe_title = "".join(c for c in title if c.isalnum() or c in " _-")[:40].strip() or str(uuid.uuid4())[:8]
                new_filename = f"{safe_title}{ext}"
                base, extension = os.path.splitext(new_filename)
                counter = 1
                while os.path.exists(os.path.join(UPLOAD_DIR, new_filename)):
                    new_filename = f"{base}_{counter}{extension}"
                    counter += 1
                filepath = os.path.join(UPLOAD_DIR, new_filename)
                with open(filepath, "wb") as f:
                    f.write(file_item.file.read())
                works = load_works()
                works.append({
                    "id": str(uuid.uuid4())[:8],
                    "title": title,
                    "filename": new_filename,
                    "created_at": datetime.now().strftime("%Y-%m-%d"),
                    "steps": steps,
                    "likes": 0,
                    "comments": [],
                    "category": category,
                    "tags": tags,
                    "country": country,
                    "season": season,
                    "description": description
                })
                save_works(works)
                print(f"上傳成功：{title}")
                self.send_redirect("/admin/dashboard")
                return

            if path.startswith("/admin/edit/"):
                if not is_logged_in(self):
                    self.send_redirect("/admin")
                    return
                work_id = path.split("/admin/edit/")[-1].strip("/")
                content_length = int(self.headers.get("Content-Length", 0))
                body = self.rfile.read(content_length).decode("utf-8", errors="ignore")
                params = parse_qs(body)
                title = params.get("title", [""])[0].strip()
                steps = params.get("steps", [""])[0].strip() if "steps" in params else ""
                category = params.get("category", ["主食"])[0].strip()
                country = params.get("country", ["沒有"])[0].strip()
                tags_raw = params.get("tags", [""])[0].strip()
                tags = [t.strip() for t in tags_raw.split(",") if t.strip()]
                works = load_works()
                seasons = params.get("season", [])
                season = ",".join(seasons) if isinstance(seasons, list) else seasons
                for w in works:
                    if w.get("id") == work_id:
                        if title: w["title"] = title
                        w["steps"] = steps
                        w["category"] = category
                        w["season"] = season
                        w["tags"] = tags
                        w["country"] = country
                        w["description"] = description
                        w["season"] = season
                        break
                save_works(works)
                print(f"已更新作品：{title}")
                self.send_redirect("/admin/dashboard")
                return

            if path.startswith("/admin/delete/"):
                if not is_logged_in(self):
                    self.send_redirect("/admin")
                    return
                work_id = path.split("/admin/delete/")[-1].strip("/")
                works = load_works()
                works = [w for w in works if w.get("id") != work_id]
                save_works(works)
                self.send_redirect("/admin/dashboard")
                return

            if path.startswith("/admin/delete-comment/"):
                if not is_logged_in(self):
                    self.send_redirect("/admin")
                    return
                parts = path.split("/admin/delete-comment/")[-1].strip("/").split("/")
                if len(parts) >= 2:
                    work_id, comment_id = parts[0], parts[1]
                    works = load_works()
                    for w in works:
                        if w.get("id") == work_id and "comments" in w:
                            w["comments"] = [c for c in w["comments"] if c.get("id") != comment_id]
                            break
                    save_works(works)
                self.send_redirect(f"/admin/edit/{work_id}")
                return

            self.send_error(404)
        except Exception as e:
            print(f"POST Error: {e}")
            import traceback
            traceback.print_exc()
            try:
                self.send_redirect("/admin/dashboard")
            except:
                pass

def main():
    if not os.path.exists(DATA_FILE):
        save_works([])
    print("=" * 40)
    print("  溱溱有味 · 美食手帳")
    print("=" * 40)
    print(f"前台： http://127.0.0.1:{PORT}/")
    print(f"後台： http://127.0.0.1:{PORT}/admin")
    print(f"密碼： {ADMIN_PASSWORD}")
    print("按 Ctrl+C 停止")
    print("=" * 40)
    server = HTTPServer(("0.0.0.0", PORT), PortfolioHandler)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n伺服器已停止")
        server.server_close()

if __name__ == "__main__":
    main()
