def render_edit(work):
    steps = work.get("steps", "") or ""
    description = work.get("description", "") or ""
    comments = work.get("comments", [])
    category = work.get("category", "主食")
    country = work.get("country", "")
    season = work.get("season", "") or ""
    tags = ", ".join(work.get("tags", []))

    if comments:
        comment_items = []
        for c in comments:
            name = html.escape(c.get("name", "匿名"))
            time = html.escape(c.get("time", ""))
            text = html.escape(c.get("text", ""))
            cid = html.escape(c.get("id", ""))
            wid = html.escape(work["id"])
            item = f'<div class="work-item" style="padding:0.6rem 0;"><div class="work-item-info"><div class="title">{name} <span style="font-weight:normal;color:#999;font-size:0.85rem;">{time}</span></div><div class="date">{text}</div></div><form method="POST" action="/admin/delete-comment/{wid}/{cid}" onsubmit="return confirm(\'確定刪除這則留言？\');" style="margin:0;"><button type="submit" class="btn-delete">刪除</button></form></div>'
            comment_items.append(item)
        comments_html = '<div class="works-list">' + ''.join(comment_items) + '</div>'
       else:
        comments_html = '<div class="empty-state"><p>目前沒有留言</p></div>'

    cat_options = ''.join(f'<option value="{c}" {"selected" if c == category else ""}>{c}</option>' for c in CATEGORIES)
    country_options = ''.join(f'<option value="{c}" {"selected" if c == country else ""}>{c}</option>' for c in COUNTRIES)

    spring_checked = "checked" if "春" in season else ""
    summer_checked = "checked" if "夏" in season else ""
    autumn_checked = "checked" if "秋" in season else ""
    winter_checked = "checked" if "冬" in season else ""

    return f'''<!DOCTYPE html>
